rules_version = '2';

// Solo la cuenta del docente puede leer o escribir.
//
// Antes se permitía a cualquier sesión iniciada (request.auth != null): si el registro
// de cuentas sigue habilitado en Firebase, cualquiera con la clave pública del proyecto
// podía crearse una cuenta y leer los datos de los estudiantes.
//
// Dónde sale el UID: consola de Firebase, Authentication, Usuarios, columna
// «UID de usuario» de la cuenta del docente. Mientras quede el texto de ejemplo,
// nadie tiene acceso (falla del lado seguro).

service cloud.firestore {
  match /databases/{database}/documents {

    function esDocente() {
      return request.auth != null && request.auth.uid in [
        "PEGAR_AQUI_EL_UID_DEL_DOCENTE"
      ];
    }

    match /{document=**} {
      allow read, write: if esDocente();
    }

    // Cuando entre otro docente (docs/adr/0002-interfaz-v2-y-modelo-multicurso.md),
    // su curso se abre aparte, por ejemplo:
    //
    // match /cursos/{curso}/{document=**} {
    //   allow read, write: if request.auth != null
    //     && request.auth.uid in get(/databases/$(database)/documents/cursos/$(curso)).data.docentes;
    // }
    //
    // y la regla general de arriba queda solo para el docente dueño de la base.
  }
}
